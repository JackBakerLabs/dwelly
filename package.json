{
  "name": "dwelly-maintenance-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "replay": "node dist/src/cli.js replay",
    "inspect": "node dist/src/cli.js inspect",
    "eval": "node dist/src/cli.js eval",
    "live": "node dist/src/cli.js live",
    "coordinate": "node dist/src/cli.js coordinate",
    "reconcile": "node dist/src/cli.js reconcile",
    "diagnose": "node dist/src/cli.js diagnose",
    "eval-fresh": "node dist/src/cli.js eval-fresh",
    "ack-wait": "node dist/src/cli.js ack-wait",
    "eval-conversations": "node dist/src/evaluation/run-conversations.js"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.2"
  }
}
