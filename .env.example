# Load these into your shell; the CLI does not automatically read this file.
DWELLY_BASE_URL=https://167.172.96.156.sslip.io
DWELLY_SESSION_ID=interview-session-1
DWELLY_TOKEN=
# Optional explicit SQLite path (use a separate database for each reset/session).
# DWELLY_DB=.data/interview-session-1.sqlite

# Recommended interview provider/model (OpenRouter):
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Alternative: OpenAI direct
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional positive integer: time until a waiting item needs operator review (milliseconds).
# Choose an operational value explicitly; no default SLA is assumed.
# DWELLY_REVIEW_AFTER_MS=
